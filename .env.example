# Copy to .env and fill in. (.env is git-ignored.)

# Hosted Postgres connection string (Neon, Supabase, ...). Tables are created
# automatically on first request.
#   Neon:     postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
#   Supabase: use the "Transaction pooler" string (port 6543) from Project Settings > Database
DATABASE_URL=

# Secret mixed into PIN hashes. A 4-digit PIN has only 10,000 combinations, so
# keep this out of the database. Generate one with:  openssl rand -hex 32
# Set it once and never change it, or existing PINs stop working.
AUTH_SECRET=
